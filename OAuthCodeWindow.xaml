<Window x:Class="Mailcario.OAuthCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mailcario · Microsoft" Icon="Assets/Mailcario-512.png"
        Width="470" Height="300" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Canvas}"
        FontFamily="Segoe UI" FontSize="13">
  <Grid Margin="28,26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
    <TextBlock x:Name="Instructions" Grid.Row="1" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,16"/>
    <StackPanel Grid.Row="2">
      <TextBlock x:Name="CodeLabel" Foreground="{DynamicResource Muted}"/>
      <TextBlock x:Name="CodeValue" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource AccentDark}" Margin="0,4,0,10"/>
      <TextBlock x:Name="WaitingLabel" Foreground="{DynamicResource Muted}"/>
    </StackPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Click="Cancel_Click" Margin="0,0,9,0"/>
      <Button x:Name="OpenBrowserButton" Style="{StaticResource AccentButton}" Click="OpenBrowser_Click"/>
    </StackPanel>
  </Grid>
</Window>
