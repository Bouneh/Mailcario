<Application x:Class="Mailcario.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Accent" Color="#438EC7"/>
    <SolidColorBrush x:Key="AccentDark" Color="#85C6F5"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#2B3C4B"/>
    <SolidColorBrush x:Key="Ink" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Muted" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="Stroke" Color="#424242"/>
    <SolidColorBrush x:Key="Canvas" Color="#242424"/>
    <SolidColorBrush x:Key="Sidebar" Color="#1D1D1D"/>
    <SolidColorBrush x:Key="Surface" Color="#292929"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#303030"/>
    <SolidColorBrush x:Key="Hover" Color="#353535"/>
    <SolidColorBrush x:Key="Selected" Color="#414141"/>
    <SolidColorBrush x:Key="TitleBar" Color="#171717"/>
    <SolidColorBrush x:Key="Rail" Color="#171717"/>
    <SolidColorBrush x:Key="SearchField" Color="#303030"/>
    <SolidColorBrush x:Key="SearchStroke" Color="#494949"/>
    <SolidColorBrush x:Key="MessageGroup" Color="#363636"/>
    <SolidColorBrush x:Key="SelectedStroke" Color="#727272"/>
    <SolidColorBrush x:Key="StatusBar" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="FileShade" Color="#AA080808"/>
    <SolidColorBrush x:Key="ReaderAvatar" Color="#155A91"/>
    <SolidColorBrush x:Key="PrivacyBg" Color="#323A43"/>
    <SolidColorBrush x:Key="PrivacyStroke" Color="#526477"/>
    <SolidColorBrush x:Key="InviteStroke" Color="#47617A"/>
    <SolidColorBrush x:Key="TrackingBg" Color="#3A3028"/>
    <SolidColorBrush x:Key="TrackingStroke" Color="#796547"/>
    <SolidColorBrush x:Key="TrackingText" Color="#F0C995"/>
    <SolidColorBrush x:Key="IconMail" Color="#78C9ED"/>
    <SolidColorBrush x:Key="IconReply" Color="#C49ADD"/>
    <SolidColorBrush x:Key="IconForward" Color="#86B7EE"/>
    <SolidColorBrush x:Key="IconNeutral" Color="#A4C8DC"/>
    <SolidColorBrush x:Key="IconSync" Color="#89C99D"/>
    <SolidColorBrush x:Key="IconFolder" Color="#D3B176"/>
    <SolidColorBrush x:Key="IconDanger" Color="#D78F8F"/>
    <SolidColorBrush x:Key="AccentHover" Color="#347FB5"/>
    <SolidColorBrush x:Key="ErrorText" Color="#EE8A8A"/>

    <Style x:Key="ChromeButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="13,11"/>
    </Style>
    <Style x:Key="NavActiveButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentDark}"/>
    </Style>
    <Style x:Key="RibbonCommandButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentDark}"/>
      <Setter Property="Padding" Value="5"/>
      <Setter Property="MinWidth" Value="72"/>
      <Setter Property="Height" Value="80"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24" Foreground="{TemplateBinding BorderBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="96" HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RibbonTabButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="FileActionButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource AccentDark}" Margin="0,0,12,0"/>
                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="12" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ChromeButton}"/>
    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="3"/>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="MailMessageContextMenuStyle" TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="MinWidth" Value="348"/>
      <Setter Property="MaxHeight" Value="620"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Stroke}"
                    BorderThickness="1" CornerRadius="7" Padding="4">
              <ScrollViewer MaxHeight="610" VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MailMessageMenuItemStyle" TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinHeight" Value="33"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Grid>
              <Border x:Name="ItemChrome" Background="Transparent" CornerRadius="4" Margin="3,1" Padding="7,4">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="29"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/>
                  </Grid.ColumnDefinitions>
                  <ContentPresenter ContentSource="Icon" Width="20" Height="20"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                    VerticalAlignment="Center" Margin="5,0,4,0"/>
                  <Path x:Name="SubmenuArrow" Grid.Column="2" Data="M2,1 L6,5 L2,9"
                        Stroke="{DynamicResource Muted}" StrokeThickness="1.6"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        StrokeLineJoin="Round" Width="8" Height="10" Stretch="Uniform"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
              </Border>
              <Popup x:Name="PART_Popup" Placement="Right"
                     PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                     IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                     AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}"
                        BorderThickness="1" CornerRadius="7" Padding="4" MinWidth="258">
                  <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource AccentSoft}"/>
              </Trigger>
              <Trigger Property="HasItems" Value="True">
                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MailMessageSeparatorStyle" TargetType="Separator">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Background="{DynamicResource Stroke}" Margin="39,5,11,5"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <DataTemplate x:Key="ContactListItemTemplate">
      <TextBlock Text="{Binding DisplayLabel}" Foreground="{DynamicResource Ink}"
                 FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                 ToolTip="{Binding DisplayLabel}" VerticalAlignment="Center"/>
    </DataTemplate>
    <Style x:Key="ContactListItemStyle" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ContactRow" Background="Transparent" BorderBrush="Transparent"
                    BorderThickness="1" CornerRadius="4" Margin="2,1" Padding="9,6">
              <ContentPresenter ContentSource="Content" HorizontalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ContactRow" Property="Background" Value="{DynamicResource Hover}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ContactRow" Property="Background" Value="{DynamicResource Selected}"/>
                <Setter TargetName="ContactRow" Property="BorderBrush" Value="{DynamicResource SelectedStroke}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" BorderThickness="0" Background="Transparent" Padding="0">
                <Grid>
                  <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3"/>
                  <TextBlock Text="{Binding SelectedItem.Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" Margin="9,0,28,0" IsHitTestVisible="False"/>
                  <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" IsHitTestVisible="False"/>
                </Grid>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="7" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemChrome" Background="{TemplateBinding Background}" CornerRadius="4" Margin="2,1" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Content" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
