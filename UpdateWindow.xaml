<Window x:Class="Mailcario.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mailcario" Width="460" Height="260" MinWidth="420" MinHeight="240"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Canvas}" FontFamily="Segoe UI" FontSize="13">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
      <TextBlock x:Name="Description" Margin="0,13,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
    </StackPanel>
    <StackPanel Grid.Row="1" VerticalAlignment="Center">
      <ProgressBar x:Name="DownloadProgress" Height="7" Minimum="0" Maximum="100" Visibility="Collapsed"/>
      <TextBlock x:Name="ProgressLabel" Margin="0,9,0,0" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="LaterButton" Style="{StaticResource ChromeButton}" Margin="0,0,8,0" Click="Later_Click"/>
      <Button x:Name="DownloadButton" Style="{StaticResource AccentButton}" Click="Download_Click"/>
    </StackPanel>
  </Grid>
</Window>
