<Window x:Class="Mailcario.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mailcario" Icon="Assets/Mailcario-512.png"
        Width="500" MinWidth="460" MinHeight="390" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Canvas}"
        FontFamily="Segoe UI" FontSize="13">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
      <Image Source="Assets/Mailcario-512.png" Width="48" Height="48"/>
      <StackPanel Margin="14,1,0,0" VerticalAlignment="Center">
        <TextBlock Text="Mailcario" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
        <TextBlock x:Name="AboutHeading" Foreground="{DynamicResource Muted}"/>
      </StackPanel>
    </StackPanel>
    <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="5" Padding="18">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="VersionLabel" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,0,0,12"/>
        <Button x:Name="RepositoryButton" Grid.Row="1" Style="{StaticResource ChromeButton}" HorizontalAlignment="Left" Click="Repository_Click" Margin="0,0,0,14"/>
        <ScrollViewer Grid.Row="2" MaxHeight="120" Margin="0,0,0,12"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <TextBlock x:Name="UpdateStatus" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
        </ScrollViewer>
        <WrapPanel Grid.Row="3" Orientation="Horizontal">
          <Button x:Name="CheckButton" Style="{StaticResource ChromeButton}" Click="Check_Click" Margin="0,0,8,0"/>
          <Button x:Name="DownloadButton" Style="{StaticResource AccentButton}" Click="Download_Click" Visibility="Collapsed"/>
        </WrapPanel>
      </Grid>
    </Border>
    <Button x:Name="CloseButton" Grid.Row="2" HorizontalAlignment="Right" Margin="0,18,0,0" Click="Close_Click"/>
  </Grid>
</Window>
