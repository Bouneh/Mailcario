<Window x:Class="Mailcario.AttachmentPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Mailcario" Width="900" Height="680" MinWidth="540" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Canvas}" FontFamily="Segoe UI" FontSize="13">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}"
            BorderThickness="1" CornerRadius="5" Padding="17,13" Margin="0,0,0,14">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="23"
                   Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1">
          <TextBlock x:Name="FileNameLabel" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="DetailsLabel" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}"
            BorderThickness="1" CornerRadius="5" ClipToBounds="True">
      <Grid>
        <TextBox x:Name="TextPreview" IsReadOnly="True" Visibility="Collapsed" FontFamily="Cascadia Code, Consolas"
                 FontSize="13" Foreground="{DynamicResource Ink}" Background="Transparent" BorderThickness="0"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="20"/>
        <ScrollViewer x:Name="ImageScroller" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Image x:Name="ImagePreview" Stretch="Uniform" Margin="16"/>
        </ScrollViewer>
        <wv2:WebView2 x:Name="PdfPreview" Visibility="Collapsed"/>
        <StackPanel x:Name="EmptyPreview" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25">
          <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="34"
                     Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/>
          <TextBlock x:Name="EmptyPreviewText" FontSize="14" Foreground="{DynamicResource Muted}"
                     TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
      <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" Padding="14,8" Click="Save_Click"/>
      <Button x:Name="PrintButton" Margin="9,0,0,0" Padding="14,8" Click="Print_Click"/>
      <Button x:Name="CloseButton" Margin="9,0,0,0" Padding="14,8" Click="Close_Click"/>
    </StackPanel>
  </Grid>
</Window>
