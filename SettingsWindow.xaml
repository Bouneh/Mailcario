<Window x:Class="Mailcario.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mailcario" Width="600" Height="700" MinWidth="520" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Canvas}" FontFamily="Segoe UI" FontSize="13">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <TextBlock x:Name="Heading" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
      <TextBlock x:Name="Subtitle" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="5" Padding="19" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock x:Name="AppearanceHeading" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="ThemeLabel" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <ComboBox x:Name="ThemeCombo" Width="190">
                <ComboBoxItem Tag="system"/><ComboBoxItem Tag="light"/><ComboBoxItem Tag="dark"/>
              </ComboBox>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="5" Padding="19" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock x:Name="NotificationsHeading" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,0,0,13"/>
            <CheckBox x:Name="NotifyCheck" Margin="0,0,0,10"/>
            <CheckBox x:Name="SoundCheck" Margin="0,0,0,10"/>
            <CheckBox x:Name="PreviewCheck" Margin="0,0,0,13"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="IntervalLabel" VerticalAlignment="Center" Foreground="{DynamicResource Ink}" Margin="0,0,12,0"/>
              <ComboBox x:Name="IntervalBox" Width="105" SelectedValuePath="Tag">
                <ComboBoxItem Content="1 min" Tag="1"/><ComboBoxItem Content="2 min" Tag="2"/>
                <ComboBoxItem Content="5 min" Tag="5"/><ComboBoxItem Content="10 min" Tag="10"/>
                <ComboBoxItem Content="15 min" Tag="15"/><ComboBoxItem Content="30 min" Tag="30"/>
              </ComboBox>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="5" Padding="19" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock x:Name="LayoutHeading" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,0,0,13"/>
            <CheckBox x:Name="RibbonCheck" Margin="0,0,0,10"/>
            <CheckBox x:Name="ReaderCheck" Margin="0,0,0,10"/>
            <CheckBox x:Name="CompactCheck" Margin="0,0,0,14"/>
            <TextBlock x:Name="RibbonGroupsHeading" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,0,0,9"/>
            <CheckBox x:Name="HomeCheck" Margin="0,0,0,7"/>
            <CheckBox x:Name="SyncCheck" Margin="0,0,0,7"/>
            <CheckBox x:Name="FolderCheck" Margin="0,0,0,7"/>
            <CheckBox x:Name="ViewCheck" Margin="0,0,0,7"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,17,0,0">
      <Button x:Name="CancelButton" Margin="0,0,8,0" Click="Cancel_Click"/>
      <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
